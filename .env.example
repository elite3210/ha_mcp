# URL interna de Home Assistant en el VPS
HA_URL=http://127.0.0.1:8123

# Long-Lived Access Token de Home Assistant
# Créalo en: HA → tu usuario → Tokens de acceso de larga duración
HA_TOKEN=your_ha_long_lived_token_here

# Secreto para firmar los JWT de Heinzbot (genera uno con: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE_HOURS=8

# Dónde escucha el servidor MCP (no cambiar en producción)
MCP_HOST=127.0.0.1
MCP_PORT=8002

# Ruta del log de auditoría (registra escrituras/acciones)
AUDIT_LOG_PATH=/opt/ha-mcp/audit.jsonl
