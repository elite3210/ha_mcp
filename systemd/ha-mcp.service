[Unit]
Description=HA MCP Server — Home Assistant para Heinzbot
After=network.target

[Service]
Type=simple
User=odoo
Group=odoo
WorkingDirectory=/opt/ha-mcp
EnvironmentFile=/opt/ha-mcp/.env
ExecStart=/opt/ha-mcp/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8002 --workers 2
Restart=always
RestartSec=5

# Logging — ver con: journalctl -u ha-mcp -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
